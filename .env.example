SERVICE_ROLE=standalone
SHARD_ID=0
SHARD_COUNT=1
# Coordinator example: SHARD_URLS=0=https://shard0.example.com,1=https://shard1.example.com,2=https://shard2.example.com
SHARD_URLS=
CLUSTER_TOKEN=
SHARD_TIMEOUT_SECONDS=5
