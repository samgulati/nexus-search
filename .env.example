ENVIRONMENT=development
ADMIN_TOKEN=
OPENAI_API_KEY=
ANSWER_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_PROVIDER=auto
CORS_ORIGINS=*
DATABASE_URL=

# Distributed mode. Leave SERVICE_ROLE=standalone for local single-node development.
SERVICE_ROLE=standalone
SHARD_ID=0
SHARD_COUNT=1
# Coordinator example: SHARD_URLS=0=https://shard0.example.com,1=https://shard1.example.com,2=https://shard2.example.com
SHARD_URLS=
CLUSTER_TOKEN=
SHARD_TIMEOUT_SECONDS=5

# Phase 3b: asynchronous indexing through Kafka / Redpanda.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_INDEX_TOPIC=nexus-index
KAFKA_DLQ_TOPIC=nexus-index-dlq
KAFKA_CONSUMER_GROUP=nexus-indexers
KAFKA_CLIENT_ID=nexus-search
INDEX_RETRY_MAX=5
INDEX_RETRY_BASE_SECONDS=0.5
INDEX_RETRY_MAX_SECONDS=10

# Phase 4: observability.
# API services expose /metrics when enabled. Workers can expose a metrics port.
METRICS_ENABLED=false
METRICS_PORT=0
# Collector base example: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional explicit /v1/traces URL; overrides the base endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=
