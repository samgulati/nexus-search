ENVIRONMENT=development
ADMIN_TOKEN=
OPENAI_API_KEY=
ANSWER_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_PROVIDER=auto
CORS_ORIGINS=*
DATABASE_URL=

