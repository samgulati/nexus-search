# Optional: enables LLM-grounded synthesis. Without it, Nexus uses a deterministic extractive answer layer.
OPENAI_API_KEY=
ANSWER_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Required only if you want to expose the indexing/crawling admin endpoints.
ADMIN_TOKEN=change-me
ENVIRONMENT=production
